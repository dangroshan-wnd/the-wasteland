# Local Postgres — database captains_log_dev (see ../naming.yml)
LOCAL_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/captains_log_dev

# Optional named pieces if LOCAL_DATABASE_URL / DATABASE_URL are unset
# PG_HOST=127.0.0.1
# PG_PORT=5432
# PG_NAME=captains_log_dev
# PG_USER=postgres
# PG_PASS=replace-me

# Neon — database captains_log; publish_schema_to_neon.py never copies rows
NEON_DATABASE_URL=postgresql://user:password@your-neon-host/captains_log?sslmode=require
