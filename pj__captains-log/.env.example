# Local Postgres (preferred by run_sql.py)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_NAME=captains_log
PG_USER=postgres
PG_PASS=replace-me

# Optional fallback when the PG_* settings above are incomplete
# LOCAL_DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/captains_log

# Neon — publish_schema_to_neon.py never copies rows
NEON_DATABASE_URL=postgresql://user:password@your-neon-host/captains_log?sslmode=require
