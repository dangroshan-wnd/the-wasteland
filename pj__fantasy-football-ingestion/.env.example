PG_HOST=localhost
PG_PORT=5432
PG_NAME=fantasy_football
PG_USER=postgres
PG_PASS=replace-me

# Active publish/sync utilities use SQLAlchemy URLs.
LOCAL_DATABASE_URL=postgresql+psycopg2://postgres:replace-me@localhost:5432/fantasy_football
NEON_DATABASE_URL=postgresql+psycopg2://user:replace-me@host/database?sslmode=require

# Keep the real JSON file untracked. Relative paths resolve from this project root.
UD_AUTH_PATH=secrets/ud_auth.json
